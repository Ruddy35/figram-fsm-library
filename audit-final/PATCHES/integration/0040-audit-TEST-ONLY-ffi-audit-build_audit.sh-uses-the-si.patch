Subject: [PATCH 40/40] =?UTF-8?q?audit:=20TEST-ONLY=20=E2=80=94=20ffi/audi?=
 =?UTF-8?q?t/build=5Faudit.sh=20uses=20the=20single=20from-source=20adapta?=
 =?UTF-8?q?tion=20(ffi/build.sh)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NOT a product change. The branch keeps ONE way to build the embedding
library on the from-source (gcc/libstdc++) Lean toolchain: ffi/build.sh as
adapted in the previous TEST-ONLY commit (system static libuv/libgmp, empty
libc++/libc++abi stubs, C++ runtime = dynamic -lstdc++; Go: CGO_LDFLAGS=-lstdc++).
ffi-go's own adaptation in build_audit.sh (static libstdc++.a/libsupc++.a
copied as libc++.a/libc++abi.a) is replaced: build_audit.sh now calls
ffi/build.sh, copies its artefacts and links the audit binaries with -lstdc++.
Drop both TEST-ONLY commits when building with the official toolchain.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 ffi/audit/build_audit.sh | 26 +++++++++++---------------
 1 file changed, 11 insertions(+), 15 deletions(-)

diff --git a/ffi/audit/build_audit.sh b/ffi/audit/build_audit.sh
index 8e4e3ed..2e0ed62 100755
--- a/ffi/audit/build_audit.sh
+++ b/ffi/audit/build_audit.sh
@@ -7,25 +7,21 @@
 set -euo pipefail
 cd "$(dirname "$0")/../.."
 OUT=${1:-ffi/audit/out}
-lake build Figram FigramApi:static
+# AUDIT TEST-ONLY (integration): ONE from-source toolchain adaptation for the whole branch.
+# The library and the runtime archives come from ffi/build.sh (adapted in d8a548b: system
+# static libuv/libgmp, EMPTY libc++/libc++abi stubs, C++ runtime = dynamic -lstdc++), the
+# same artefacts that verify.sh and the Go build (CGO_LDFLAGS=-lstdc++) use.
+bash ffi/build.sh >/dev/null
 P=$(lean --print-prefix)
 O=.lake/build/ir/Figram
 MODS="Core Chart Compile Lint Format FormatIO Engine Api"
 OBJS=""; for m in $MODS; do OBJS="$OBJS $O/$m.c.o.export"; done
 mkdir -p "$OUT/lean"
-leanc -c -o "$OUT/figram_ffi.o" ffi/figram_ffi.c
-rm -f "$OUT/libfigram.a"
-ar rcs "$OUT/libfigram.a" "$OUT/figram_ffi.o" $OBJS
-cp "$P/lib/lean/libInit.a" "$P/lib/lean/libleanrt.a" "$OUT/lean/"
-SYS=/usr/lib/x86_64-linux-gnu
-cp "$SYS/libuv.a" "$SYS/libgmp.a" "$OUT/lean/"
-LIBS="-L$OUT -l:libfigram.a -L$OUT/lean -Wl,--start-group -lInit -lleanrt -Wl,--end-group -Wl,-Bstatic -lstdc++ -luv -lgmp -Wl,-Bdynamic -lm -ldl -lpthread -lrt"
+if [ "$(realpath "$OUT")" != "$(realpath ffi/out)" ]; then
+  cp ffi/out/figram_ffi.o ffi/out/libfigram.a "$OUT/"; cp ffi/out/lean/*.a "$OUT/lean/"
+fi
+LIBS="-L$OUT -l:libfigram.a -L$OUT/lean -Wl,--start-group -lInit -lleanrt -Wl,--end-group -Wl,-Bstatic -luv -lgmp -Wl,-Bdynamic -lstdc++ -lm -ldl -lpthread -lrt"
 echo "$LIBS" > "$OUT/LDFLAGS"
-# Для cgo: в ffi/go-example зашиты -lc++ -lc++abi из ../out/lean; при сборке Go
-# этим скриптом ffi/out — ссылка на OUT, а libc++.a/libc++abi.a — копии libstdc++.a/libsupc++.a.
-GCC_LIB=$(dirname "$(gcc -print-file-name=libstdc++.a)")
-cp "$GCC_LIB/libstdc++.a" "$OUT/lean/libc++.a"
-cp "$GCC_LIB/libsupc++.a" "$OUT/lean/libc++abi.a"
 
 A=ffi/audit
 CF="-g -O1 -I$P/include -pthread"
@@ -36,7 +32,7 @@ gcc -O1 -o "$OUT/harness_plain" ffi/c_harness.c ffi/c_harness_io.c $LIBS
 # ASan+UBSan, как verify.sh: прослойка и тесты инструментированы, модули Lean — нет.
 SAN="-fsanitize=address,undefined -fno-omit-frame-pointer"
 gcc -c -g $SAN -I"$P/include" -o "$OUT/ffi_asan.o" ffi/figram_ffi.c
-LIBS_NOFFI="-L$OUT/lean $OBJS -Wl,--start-group -lInit -lleanrt -Wl,--end-group -Wl,-Bstatic -lstdc++ -luv -lgmp -Wl,-Bdynamic -lm -ldl -lpthread -lrt"
+LIBS_NOFFI="-L$OUT/lean $OBJS -Wl,--start-group -lInit -lleanrt -Wl,--end-group -Wl,-Bstatic -luv -lgmp -Wl,-Bdynamic -lstdc++ -lm -ldl -lpthread -lrt"
 for t in contract stress; do gcc $CF $SAN -o "$OUT/${t}_asan" $A/$t.c "$OUT/ffi_asan.o" $LIBS_NOFFI; done
 gcc -g $SAN -o "$OUT/harness_asan" ffi/c_harness.c ffi/c_harness_io.c "$OUT/ffi_asan.o" $LIBS_NOFFI
 # TSan: прослойка, тесты И сгенерированный C модулей Figram инструментированы
@@ -46,6 +42,6 @@ mkdir -p "$OUT/tsan"
 for m in $MODS; do gcc -c $TS -I"$P/include" -fwrapv -DNDEBUG -o "$OUT/tsan/$m.o" $O/$m.c; done
 gcc -c $TS -I"$P/include" -o "$OUT/tsan/ffi.o" ffi/figram_ffi.c
 TSOBJS=""; for m in $MODS; do TSOBJS="$TSOBJS $OUT/tsan/$m.o"; done
-TLIBS="$OUT/tsan/ffi.o $TSOBJS -L$OUT/lean -Wl,--start-group -lInit -lleanrt -Wl,--end-group -Wl,-Bstatic -lstdc++ -luv -lgmp -Wl,-Bdynamic -lm -ldl -lpthread -lrt"
+TLIBS="$OUT/tsan/ffi.o $TSOBJS -L$OUT/lean -Wl,--start-group -lInit -lleanrt -Wl,--end-group -Wl,-Bstatic -luv -lgmp -Wl,-Bdynamic -lstdc++ -lm -ldl -lpthread -lrt"
 for t in contract stress; do gcc $CF $TS -o "$OUT/${t}_tsan" $A/$t.c $TLIBS; done
 echo "готово: $OUT"
