From ae951285cceef7a756f14013977331f69c9422b3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 22:48:31 +0000
Subject: [PATCH 12/40] test(python-client): client_robustness.py fails fast in
 long crash loops

R2 (300 crash cycles) and R9 (200 cycles) stop at the first cycle that takes
longer than an instantly detected fault should (2.5 s / 1.5 s) instead of
waiting 300 x timeout under a regression (e.g. missing wakeup of pending
callers). Same verdicts on baseline (R5-R9 red) and on the fixed client
(all green).

(cherry picked from commit bbf7ac75ae9c7278c40098c0377771a4ef432999)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 ffi/python-example/client_robustness.py | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/ffi/python-example/client_robustness.py b/ffi/python-example/client_robustness.py
index 4f1be40..75eeb30 100644
--- a/ffi/python-example/client_robustness.py
+++ b/ffi/python-example/client_robustness.py
@@ -129,14 +129,19 @@ for name, body in INSTANT.items():
 # R2: ресурсы после многих циклов «сбой → замена».
 eng = Engine(fake('read l; kill -SEGV $$'), pizza, timeout=5.0)
 base = resources()
+done = 0
 for _ in range(300):
+    t0 = time.monotonic()
     parallel(lambda i: eng.start("u"), 4)
+    done += 1
+    if time.monotonic() - t0 > 2.5:   # сбой обнаруживается сразу; не ждать 300 × срок
+        break
 eng.close()
 left = wait_children(0)
 time.sleep(0.2)
 end = resources()
-report(end[0] <= base[0] + 1 and end[1] <= base[1] + 1 and end[2] <= base[2] + 2 and not left,
-       f"R2 300 циклов сбоя: потоки Python {base[0]}→{end[0]}, потоки ОС {base[1]}→{end[1]}, "
+report(done == 300 and end[0] <= base[0] + 1 and end[1] <= base[1] + 1 and end[2] <= base[2] + 2 and not left,
+       f"R2 {done} из 300 циклов сбоя (цикл < 2.5 с): потоки Python {base[0]}→{end[0]}, потоки ОС {base[1]}→{end[1]}, "
        f"fd {base[2]}→{end[2]}, потомков после close {len(left)}")
 eng = Engine(engine_bin, pizza, processes=2, timeout=5.0)
 eng.start("a"), eng.start("b")
@@ -333,7 +338,11 @@ figram_client.os.killpg = spy
 try:
     eng = Engine(fake('read l; kill -SEGV $$'), pizza, timeout=2.0)
     for _ in range(200):
+        t0 = time.monotonic()
         parallel(lambda i: eng.start("u"), 8)
+        if time.monotonic() - t0 > 1.5:   # сбой обнаруживается сразу; не ждать 200 × срок
+            calls[1] += 1000
+            break
     eng.close()
     eng = Engine(engine_bin, pizza, processes=2, timeout=2.0)
     for _ in range(50):
