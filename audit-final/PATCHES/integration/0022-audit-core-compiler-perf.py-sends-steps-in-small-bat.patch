From dd5d4e332e02f63c5203d606f97bd44e25af8946 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 23:35:26 +0000
Subject: [PATCH 22/40] audit(core-compiler): perf.py sends steps in small
 batches (harness pipe deadlock)

Writing 200 large step requests before reading any reply filled both pipes
on documents with big snapshots; the measurement now interleaves writes and
reads.

(cherry picked from commit 3d73782393c47423d5b45a454c65e86d989b0976)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 audit/core-compiler/perf.py | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/audit/core-compiler/perf.py b/audit/core-compiler/perf.py
index 350cd26..0abbc0c 100755
--- a/audit/core-compiler/perf.py
+++ b/audit/core-compiler/perf.py
@@ -103,12 +103,14 @@ def measure(engine, text, timeout, steps=200):
     st = json.loads(p.stdout.readline())
     snap = st["snapshot"]
     t1 = time.time()
-    reqs = "".join(json.dumps({"id": 2 + i, "op": "step", "snapshot": snap, "event": "btn:none"}) + "\n"
-                   for i in range(steps))
-    p.stdin.write(reqs)
-    p.stdin.flush()
-    for i in range(steps):
-        p.stdout.readline()
+    # small batches: writing all requests before reading can deadlock on full pipes
+    for b in range(0, steps, 8):
+        reqs = "".join(json.dumps({"id": 2 + i, "op": "step", "snapshot": snap, "event": "btn:none"}) + "\n"
+                       for i in range(b, min(steps, b + 8)))
+        p.stdin.write(reqs)
+        p.stdin.flush()
+        for i in range(b, min(steps, b + 8)):
+            p.stdout.readline()
     step_us = (time.time() - t1) / steps * 1e6
     p.stdin.close()
     p.wait()
-- 
