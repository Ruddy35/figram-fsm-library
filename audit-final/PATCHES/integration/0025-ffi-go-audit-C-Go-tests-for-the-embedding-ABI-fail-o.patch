--- /dev/null
+++ b/ffi/audit/run_contract.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+# Прогон подтестов contract (каждый в своём процессе) с фиксацией кода выхода/сигнала.
+#   ffi/audit/run_contract.sh BIN_DIR [suffix]   (suffix: "" | _asan | _tsan)
+set -u
+cd "$(dirname "$0")/../.."
+B=${1:-ffi/audit/out}; S=${2:-}
+D=examples/pizza.bot.json; D2=examples/features.bot.json
+C="$B/contract$S"
+run() {
+  local name=$1; shift
+  out=$(ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=print_stacktrace=1 timeout 60 "$@" 2>&1); rc=$?
+  sig=""; [ $rc -gt 128 ] && sig=" (signal $((rc-128)))"
+  printf '=== %-34s rc=%d%s\n' "$name" $rc "$sig"
+  printf '%s\n' "$out" | grep -v '^\s*$' | head -${LINES_SHOWN:-12} | sed 's/^/    /'
+}
+run init_twice            $C init_twice
+run side_effects          $C side_effects
+for w in check fmt load; do run "before_init $w" $C before_init $w $D; done
+for w in check fmt load line handle unload free unload_failed_load; do run "null $w" $C null $w $D; done
+run unload_twice          $C unload_twice $D
+run use_after_unload      $C use_after_unload $D $D2
+run nul                   $C nul $D
+run utf8                  $C utf8 $D
+run "threads 1000"        $C threads $D 1000
diff --git a/ffi/audit/stress.c b/ffi/audit/stress.c
new file mode 100644
index 0000000..78368c8
--- /dev/null
+++ b/ffi/audit/stress.c
@@ -0,0 +1,139 @@
+// Аудит C-ABI: T потоков × N запросов к ОДНОМУ автомату одновременно с потоками,
+// которые загружают, опрашивают и выгружают ДРУГИЕ автоматы (и вызывают check/fmt).
+// Каждый ответ сверяется с эталоном, вычисленным заранее в одном потоке.
+//   ./stress DOC T N L        — проверка (для ASan/UBSan/TSan/valgrind)
+//   ./stress bench DOC T N shared|separate — пропускная способность
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <stdatomic.h>
+
+int figram_init(void);
+char* figram_check_json(const char*);
+char* figram_fmt_json(const char*);
+void* figram_load_doc(const char*);
+char* figram_request_json(void*, const char*);
+void figram_unload(void*);
+void figram_free(char*);
+
+static const char* REQS[] = {
+  "{\"id\":1,\"op\":\"hello\"}",
+  "{\"id\":2,\"op\":\"start\"}",
+  "{\"id\":3,\"op\":\"step\",\"snapshot\":{\"at\":\"menu\"},\"event\":\"btn:order\"}",
+  "{\"id\":4,\"op\":\"step\",\"snapshot\":{\"at\":\"cart\"},\"event\":\"btn:checkout\"}",
+  "{\"id\":5,\"op\":\"step\",\"snapshot\":{\"at\":\"cart\"},\"event\":\"btn:checkout\",\"guards\":{\"cart_not_empty\":true}}",
+  "{\"id\":6,\"op\":\"restart\",\"snapshot\":{\"at\":\"cart\",\"seq\":5}}",
+  "{\"id\":7,\"op\":\"step\",\"snapshot\":{\"at\":\"gone\"},\"event\":\"x\"}",
+  "{\"id\":8,\"op\":\"nope\"}",
+  "[1,2,3]",
+  "{\"id\":9",
+};
+#define NREQ (sizeof REQS / sizeof *REQS)
+static char* want[NREQ];
+static char* doc;
+static char* want_check;
+static char* want_fmt;
+static void* bot;
+static int N;
+static atomic_int stop;
+static atomic_long other_cycles;
+
+static char* read_all(const char* path) {
+  FILE* f = fopen(path, "rb");
+  if (!f) { perror(path); exit(2); }
+  fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+  char* b = malloc(n + 1);
+  if (fread(b, 1, n, f) != (size_t)n) exit(2);
+  b[n] = 0; fclose(f); return b;
+}
+
+static void* user(void* arg) {
+  long bad = 0, seed = (long)arg;
+  for (int i = 0; i < N; i++) {
+    unsigned k = (unsigned)(seed * 7 + i) % NREQ;
+    char* r = figram_request_json(bot, REQS[k]);
+    if (strcmp(r, want[k])) { if (!bad) fprintf(stderr, "MISMATCH req %u: %s\n", k, r); bad++; }
+    figram_free(r);
+  }
+  return (void*)bad;
+}
+
+static void* other(void* arg) {
+  long bad = 0;
+  (void)arg;
+  while (!atomic_load(&stop)) {
+    void* m = figram_load_doc(doc);
+    if (!m) { bad++; continue; }
+    for (unsigned k = 0; k < NREQ; k++) {
+      char* r = figram_request_json(m, REQS[k]);
+      if (strcmp(r, want[k])) bad++;
+      figram_free(r);
+    }
+    figram_unload(m);
+    char* c = figram_check_json(doc); if (strcmp(c, want_check)) bad++; figram_free(c);
+    char* f = figram_fmt_json(doc); if (strcmp(f, want_fmt)) bad++; figram_free(f);
+    atomic_fetch_add(&other_cycles, 1);
+  }
+  return (void*)bad;
+}
+
+static double now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec + t.tv_nsec / 1e9; }
+
+static void* bench_worker(void* arg) {
+  void* m = arg ? arg : bot;
+  for (int i = 0; i < N; i++) figram_free(figram_request_json(m, REQS[2]));
+  return NULL;
+}
+
+static int bench(const char* path, int T, int n, int separate) {
+  doc = read_all(path); N = n;
+  bot = figram_load_doc(doc);
+  void* own[256];
+  for (int i = 0; i < T; i++) own[i] = separate ? figram_load_doc(doc) : NULL;
+  pthread_t th[256];
+  double t0 = now();
+  for (int i = 0; i < T; i++) pthread_create(&th[i], NULL, bench_worker, own[i]);
+  for (int i = 0; i < T; i++) pthread_join(th[i], NULL);
+  double el = now() - t0;
+  printf("bench threads=%d mode=%s requests=%ld time=%.3fs rate=%.0f req/s\n", T,
+         separate ? "separate" : "shared", (long)T * n, el, T * (double)n / el);
+  return 0;
+}
+
+int main(int argc, char** argv) {
+  setvbuf(stdout, NULL, _IONBF, 0);
+  if (figram_init()) return 1;
+  if (argc == 6 && !strcmp(argv[1], "bench"))
+    return bench(argv[2], atoi(argv[3]), atoi(argv[4]), !strcmp(argv[5], "separate"));
+  if (argc != 5) { fprintf(stderr, "usage: stress DOC T N L | bench DOC T N shared|separate\n"); return 2; }
+  doc = read_all(argv[1]);
+  int T = atoi(argv[2]), L = atoi(argv[4]);
+  N = atoi(argv[3]);
+  if (T < 1 || T > 256 || N < 1 || L < 0 || L > 64) return 2;
+  bot = figram_load_doc(doc);
+  if (!bot) { printf("doc not loaded\n"); return 1; }
+  for (unsigned k = 0; k < NREQ; k++) want[k] = figram_request_json(bot, REQS[k]);
+  /* Самопроверка чувствительности: испорченный эталон обязан дать расхождения. */
+  if (getenv("FIGRAM_STRESS_SELFTEST")) want[2][2] = 'X';
+  want_check = figram_check_json(doc);
+  want_fmt = figram_fmt_json(doc);
+  pthread_t th[256], ot[64];
+  for (int i = 0; i < L; i++) pthread_create(&ot[i], NULL, other, NULL);
+  for (int i = 0; i < T; i++) pthread_create(&th[i], NULL, user, (void*)(long)i);
+  long bad = 0, obad = 0;
+  for (int i = 0; i < T; i++) { void* b; pthread_join(th[i], &b); bad += (long)b; }
+  atomic_store(&stop, 1);
+  for (int i = 0; i < L; i++) { void* b; pthread_join(ot[i], &b); obad += (long)b; }
+  long total = (long)T * N;
+  printf("shared handle: %d threads x %d = %ld requests, mismatches %ld; "
+         "%d loader threads: %ld load/10 req/unload/check/fmt cycles, mismatches %ld\n",
+         T, N, total, bad, L, atomic_load(&other_cycles), obad);
+  for (unsigned k = 0; k < NREQ; k++) figram_free(want[k]);
+  figram_free(want_check); figram_free(want_fmt);
+  figram_unload(bot);
+  if (total == 0 || (L > 0 && atomic_load(&other_cycles) == 0)) { printf("NOTHING CHECKED\n"); return 1; }
+  return bad || obad;
+}
diff --git a/ffi/go-example/audit_test.go b/ffi/go-example/audit_test.go
new file mode 100644
index 0000000..8a5fa79
--- /dev/null
+++ b/ffi/go-example/audit_test.go
@@ -0,0 +1,563 @@
+package main
+
+// Аудит обёртки Bot (ffi-go): Close против потока Request, неверный op,
+// NUL в строках, большие запросы, масштабирование и длительная нагрузка.
+// Длительные тесты включаются переменными окружения:
+//   FIGRAM_SCALING=секунд_на_замер  FIGRAM_SOAK=секунд  FIGRAM_SIGNALS=секунд
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"runtime"
+	"runtime/pprof"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func auditDoc(t testing.TB) string {
+	doc, err := os.ReadFile("../../examples/pizza.bot.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if initFigram() != 0 {
+		t.Fatal("init")
+	}
+	return string(doc)
+}
+
+var stepReq = map[string]any{"op": "step", "snapshot": map[string]any{"at": "menu"}, "event": "btn:order"}
+
+// Close из нескольких горутин посреди потока Request: ни паники, ни гонки,
+// до Close — корректные ответы, после — только ошибка «автомат освобождён».
+func TestAuditCloseRequestStorm(t *testing.T) {
+	doc := auditDoc(t)
+	var ok, closed, other atomic.Int64
+	for round := 0; round < 100; round++ {
+		bot, err := Load(doc)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var wg sync.WaitGroup
+		stop := make(chan struct{})
+		for g := 0; g < 16; g++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				for {
+					select {
+					case <-stop:
+						return
+					default:
+					}
+					_, v, err := bot.Request(stepReq)
+					switch {
+					case err == nil && v == "result":
+						ok.Add(1)
+					case err != nil && err.Error() == "автомат освобождён":
+						closed.Add(1)
+					default:
+						other.Add(1)
+						t.Errorf("unexpected: %v %v", v, err)
+					}
+				}
+			}()
+		}
+		time.Sleep(2 * time.Millisecond)
+		var cw sync.WaitGroup
+		for c := 0; c < 4; c++ {
+			cw.Add(1)
+			go func() { defer cw.Done(); bot.Close() }()
+		}
+		cw.Wait()
+		time.Sleep(time.Millisecond)
+		close(stop)
+		wg.Wait()
+		if _, _, err := bot.Request(stepReq); err == nil {
+			t.Fatal("request after Close accepted")
+		}
+	}
+	t.Logf("100 rounds × 16 goroutines: ok=%d after-close errors=%d other=%d", ok.Load(), closed.Load(), other.Load())
+	if ok.Load() == 0 || closed.Load() == 0 {
+		t.Fatalf("storm did not exercise both sides: ok=%d closed=%d", ok.Load(), closed.Load())
+	}
+}
+
+func requestNoPanic(b *Bot, req map[string]any) (resp map[string]any, v string, err error, p any) {
+	defer func() { p = recover() }()
+	resp, v, err = b.Request(req)
+	return
+}
+
+// Request({"op":"hello"}) на ОТКРЫТОМ автомате: проверка в main.go «запрос после
+// Close не отвергнут» использует именно hello и потому не может покраснеть.
+func TestAuditHelloAlwaysError(t *testing.T) {
+	bot, err := Load(auditDoc(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer bot.Close()
+	resp, v, err := bot.Request(map[string]any{"op": "hello"})
+	t.Logf("open bot, hello → resp=%v variant=%q err=%v", resp, v, err)
+	if err != nil {
+		t.Errorf("hello on an open bot returns an error, so main.go's post-Close check is vacuous: %v", err)
+	}
+}
+
+// Request без op или с op не-строкой: движок отвечает error, обёртка не должна паниковать.
+func TestAuditRequestBadOp(t *testing.T) {
+	bot, err := Load(auditDoc(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer bot.Close()
+	for _, req := range []map[string]any{{}, {"op": 1}, {"op": nil}, {"op": []any{"step"}}} {
+		resp, v, err, p := requestNoPanic(bot, req)
+		if p != nil {
+			t.Errorf("Request(%v) panicked: %v", req, p)
+			continue
+		}
+		if err != nil || v != "error" {
+			t.Errorf("Request(%v) = %v %q %v, want error variant", req, resp, v, err)
+		}
+	}
+	// После паники (если была) RWMutex не должен остаться захваченным.
+	done := make(chan struct{})
+	go func() { bot.Close(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("Close deadlocked after Request panic")
+	}
+}
+
+// Документ с NUL посередине: C.CString передаёт строку, а strlen в
+// lean_mk_string обрезает её — хвост молча игнорируется. CLI тот же текст отвергает.
+func TestAuditLoadNUL(t *testing.T) {
+	doc := auditDoc(t)
+	glued := doc + "\x00{\"this is\": garbage"
+	if b, err := Load(glued); err == nil {
+		b.Close()
+		t.Errorf("Load accepted a document with NUL and trailing garbage (%d bytes, %d after NUL)",
+			len(glued), len(glued)-len(doc)-1)
+	}
+	// Тот же текст через CLI (если собран) — для сравнения.
+	if cli := os.Getenv("FIGRAM_CLI"); cli != "" {
+		f := t.TempDir() + "/nul.json"
+		os.WriteFile(f, []byte(glued), 0o644)
+		out, err := exec.Command(cli, "check", f).CombinedOutput()
+		t.Logf("CLI %s check on the same bytes: err=%v out=%.120s", cli, err, out)
+	}
+}
+
+// NUL внутри значений запроса: json.Marshal экранирует его (\u0000), до C он не доходит.
+func TestAuditRequestNUL(t *testing.T) {
+	bot, err := Load(auditDoc(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer bot.Close()
+	resp, v, err := bot.Request(map[string]any{"op": "step", "snapshot": map[string]any{"at": "menu\x00x"}, "event": "btn:order"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("NUL in snapshot.at → variant %s resp %v", v, resp)
+	resp, v, err = bot.Request(map[string]any{"op": "step", "snapshot": map[string]any{"at": "menu"}, "event": "btn:order\x00"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("NUL in event → variant %s resp %v", v, resp)
+}
+
+func rssNowKB() int64 {
+	b, _ := os.ReadFile("/proc/self/status")
+	for _, l := range strings.Split(string(b), "\n") {
+		if strings.HasPrefix(l, "VmRSS:") {
+			n, _ := strconv.ParseInt(strings.Fields(l)[1], 10, 64)
+			return n
+		}
+	}
+	return 0
+}
+
+func hwmKB() int64 {
+	b, _ := os.ReadFile("/proc/self/status")
+	for _, l := range strings.Split(string(b), "\n") {
+		if strings.HasPrefix(l, "VmHWM:") {
+			n, _ := strconv.ParseInt(strings.Fields(l)[1], 10, 64)
+			return n
+		}
+	}
+	return 0
+}
+
+// Большие запросы: длинное событие и объект guards из многих ключей.
+// Фиксируются время и пик памяти (VmHWM), ответ обязан быть корректным.
+func TestAuditLargeRequests(t *testing.T) {
+	bot, err := Load(auditDoc(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer bot.Close()
+	for _, mb := range []int{1, 8, 32} {
+		ev := "btn:" + strings.Repeat("x", mb<<20)
+		h0 := hwmKB()
+		t0 := time.Now()
+		_, v, err := bot.Request(map[string]any{"op": "step", "snapshot": map[string]any{"at": "menu"}, "event": ev})
+		t.Logf("event %d MB: variant=%s err=%v time=%v VmHWM %d→%d MB", mb, v, err, time.Since(t0).Round(time.Millisecond), h0>>10, hwmKB()>>10)
+		if err != nil || v != "result" {
+			t.Errorf("event %d MB: %v %v", mb, v, err)
+		}
+	}
+	for _, n := range []int{1000, 4000, 16000} {
+		g := make(map[string]any, n)
+		for i := 0; i < n; i++ {
+			g[fmt.Sprintf("g%06d", i)] = true
+		}
+		t0 := time.Now()
+		_, v, err := bot.Request(map[string]any{"op": "step", "snapshot": map[string]any{"at": "cart"}, "event": "btn:checkout", "guards": g})
+		t.Logf("guards with %d keys: variant=%s err=%v time=%v", n, v, err, time.Since(t0).Round(time.Millisecond))
+	}
+}
+
+// Пропускная способность 1/2/4 горутин: один общий автомат против отдельного на горутину.
+func TestAuditScaling(t *testing.T) {
+	secs, _ := strconv.ParseFloat(os.Getenv("FIGRAM_SCALING"), 64)
+	if secs <= 0 {
+		t.Skip("FIGRAM_SCALING not set")
+	}
+	doc := auditDoc(t)
+	measure := func(k int, separate bool) float64 {
+		bots := make([]*Bot, k)
+		shared, _ := Load(doc)
+		for i := range bots {
+			if separate {
+				bots[i], _ = Load(doc)
+			} else {
+				bots[i] = shared
+			}
+		}
+		var n atomic.Int64
+		var wg sync.WaitGroup
+		deadline := time.Now().Add(time.Duration(secs * float64(time.Second)))
+		t0 := time.Now()
+		for i := 0; i < k; i++ {
+			wg.Add(1)
+			go func(b *Bot) {
+				defer wg.Done()
+				runtime.LockOSThread()
+				for time.Now().Before(deadline) {
+					if _, _, err := b.Request(stepReq); err != nil {
+						t.Error(err)
+						return
+					}
+					n.Add(1)
+				}
+			}(bots[i])
+		}
+		wg.Wait()
+		rate := float64(n.Load()) / time.Since(t0).Seconds()
+		shared.Close()
+		for _, b := range bots {
+			b.Close()
+		}
+		return rate
+	}
+	for rep := 0; rep < 3; rep++ {
+		for _, k := range []int{1, 2, 4} {
+			s := measure(k, false)
+			p := measure(k, true)
+			t.Logf("rep %d goroutines=%d GOMAXPROCS=%d shared=%.0f req/s separate=%.0f req/s ratio=%.2f",
+				rep, k, runtime.GOMAXPROCS(0), s, p, s/p)
+		}
+	}
+}
