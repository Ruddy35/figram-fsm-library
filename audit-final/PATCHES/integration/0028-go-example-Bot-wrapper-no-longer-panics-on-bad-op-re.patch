From 17b0609bdaf865492e3227b5fda619f553864a59 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 23:59:36 +0000
Subject: [PATCH 28/40] go-example: Bot wrapper no longer panics on bad op,
 rejects NUL docs, accepts hello

- Request: req["op"].(string) panicked when op was missing or not a string
  (engine itself answers {error}); now the error variant is returned.
- Load: C.CString + strlen silently truncated a document at the first NUL
  (trailing garbage accepted, CLI rejects the same bytes); now an error.
- checkReply: the hello reply was always a protocol error, so main.go's
  'request after Close rejected' check could never fail (a Close no-op
  mutant passed); hello is now a valid variant and the mutant turns red.

Regression: audit_test.go TestAuditRequestBadOp, TestAuditLoadNUL,
TestAuditHelloAlwaysError (FAIL before, PASS after).

(cherry picked from commit a0279052744d26ea3e89f519ba24f898239b511f)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 ffi/audit/go_verify_block.sh | 17 +++++++++++++++++
 ffi/go-example/main.go       | 15 ++++++++++++++-
 2 files changed, 31 insertions(+), 1 deletion(-)
 create mode 100755 ffi/audit/go_verify_block.sh

diff --git a/ffi/audit/go_verify_block.sh b/ffi/audit/go_verify_block.sh
new file mode 100755
index 0000000..9471990
--- /dev/null
+++ b/ffi/audit/go_verify_block.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+# Шаги Go из verify.sh на адаптированной сборке (ffi/out -> ffi/audit/out). Код 0 — всё зелёное/красное как надо.
+#   ffi/audit/go_verify_block.sh TRACES_BIG TRACES_SMALL
+set -u
+cd "$(dirname "$0")/../go-example"
+BIG=$1; SMALL=$2; D=../../examples/pizza.bot.json; rc=0
+CC=gcc go build -o gofig . && ./gofig -rounds 3 -bots 4 $D "$BIG" || rc=1
+CC=gcc go build -race -o gofig-race . && GOMAXPROCS=4 ./gofig-race -rounds 3 -bots 3 $D "$SMALL" || rc=1
+for a in "-rounds 0" "-bots 0"; do ./gofig $a $D "$SMALL" >/dev/null 2>&1 && { echo "НЕТ: принято $a"; rc=1; }; done
+for k in recovered-broken recovered-false no-id extra-error empty seq-bool null-snapshot; do
+  ./gofig -corrupt $k $D "$SMALL" >/dev/null 2>&1 && { echo "НЕТ: не замечена порча $k"; rc=1; }
+done
+echo "порча и неверные аргументы: красные"
+./gofig -reload 5000 $D "$SMALL" || rc=1
+(head -1 "$SMALL"; echo '{oops') > /tmp/corrupt.$$.jsonl
+./gofig $D /tmp/corrupt.$$.jsonl >/dev/null 2>&1 && { echo "НЕТ: повреждённый сценарий принят"; rc=1; }; rm -f /tmp/corrupt.$$.jsonl
+echo "go_verify_block rc=$rc"; exit $rc
