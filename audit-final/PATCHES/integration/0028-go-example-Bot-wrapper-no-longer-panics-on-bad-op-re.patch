 	}
-	variant, err := checkReply(resp, id, req["op"].(string))
+	// op может отсутствовать или быть не строкой: движок ответит error, паники нет.
+	op, _ := req["op"].(string)
+	variant, err := checkReply(resp, id, op)
 	return resp, variant, err
 }
 
