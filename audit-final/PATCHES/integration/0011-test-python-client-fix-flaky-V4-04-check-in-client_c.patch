From fff6018cf0ef8d78916fa9a5b17c93f2c2aa4b28 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 22:43:26 +0000
Subject: [PATCH 11/40] test(python-client): fix flaky V4-04 check in
 client_contract.py (ESRCH race)

state() read /proc/PID/stat catching only FileNotFoundError; when the crashed
engine is reaped between open() and read(), read() raises ProcessLookupError
and the whole test dies with a traceback. Baseline: 6 of 30 runs failed on a
loaded 4-core host (r13_contract_flaky.sh); with the fix 0 of 30, both with the
baseline and the fixed client.

(cherry picked from commit 2550540dfce7185fa2227808b4373912647ddbcd)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 ffi/python-example/client_contract.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/ffi/python-example/client_contract.py b/ffi/python-example/client_contract.py
index bf96a83..0425f99 100644
--- a/ffi/python-example/client_contract.py
+++ b/ffi/python-example/client_contract.py
@@ -59,8 +59,10 @@ eng.close()
 # Повторный need → ошибка; аварийный процесс собран без следующих запросов (V4-04).
 def state(pid):
     try:
-        return open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[0]
-    except FileNotFoundError:
+        with open(f"/proc/{pid}/stat") as f:
+            return f.read().rsplit(")", 1)[1].split()[0]
+    except (FileNotFoundError, ProcessLookupError):
+        # ProcessLookupError (ESRCH): процесс собран между open() и read().
         return "собран"
 
 
