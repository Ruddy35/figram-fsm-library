From 8134324dd7f8c6d3e8fff8b25c3b2e89548e57e8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 00:21:23 +0000
Subject: [PATCH 26/40] test(ffi-go): fix data race in TestAuditThreadCount
 (sampler vs reader of maxT)

The sampler goroutine wrote maxT and the test read it after close(stop)
without a happens-before edge; under -race the test failed with
"DATA RACE ... audit_test.go:481" independently of the product code.
The test now waits for the sampler to exit before reading maxT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 ffi/go-example/audit_test.go | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/ffi/go-example/audit_test.go b/ffi/go-example/audit_test.go
index 8a5fa79..5935e17 100644
--- a/ffi/go-example/audit_test.go
+++ b/ffi/go-example/audit_test.go
@@ -452,7 +452,9 @@ func TestAuditThreadCount(t *testing.T) {
 	var bad atomic.Int64
 	maxT := 0
 	stop := make(chan struct{})
+	sampled := make(chan struct{}) // the sampler's write of maxT happens before the read below
 	go func() {
+		defer close(sampled)
 		for {
 			select {
 			case <-stop:
@@ -477,6 +479,7 @@ func TestAuditThreadCount(t *testing.T) {
 	}
 	wg.Wait()
 	close(stop)
+	<-sampled
 	t.Logf("1000 goroutines × 50 requests, GOMAXPROCS=%d: OS threads before %d, max during %d, after %d, bad %d",
 		runtime.GOMAXPROCS(0), before, maxT, tasks(), bad.Load())
 	if bad.Load() != 0 {
