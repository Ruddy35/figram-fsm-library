From 072a897152d029936d5918adfb91dcd3dc72e933 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 22:39:47 +0000
Subject: [PATCH 33/40] verify-prebuilt.sh: fatal golden mismatch, count
 floors; add verify-faults.sh
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- golden.jsonl and both example documents compared with figram golden;
  mismatch is fatal (was 'cmp ... && echo ok', ignored under set -e).
- Coverage 'A из B' must be complete; random docs, fuzz cases, snapshot
  fixtures, mutants (>= 107), selftest checks (>= 35), host contract and
  load lines are parsed and must be non-zero / at their floors.
- --quick exits 3 (reduced check is not a pass); unknown argument fails.
- verify-faults.sh injects faults into copies of the tree and requires the
  gate to go red (exit 1) on each and green without them.

(cherry picked from commit 37d0b6f422933b0596f779b9a95280b3e5d88951)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 verify-faults.sh   | 105 +++++++++++++++++++++++++++++++++++++++++++++
 verify-prebuilt.sh |  77 +++++++++++++++++++++++++++------
 2 files changed, 170 insertions(+), 12 deletions(-)
 create mode 100755 verify-faults.sh

diff --git a/verify-faults.sh b/verify-faults.sh
new file mode 100755
index 0000000..f8d5c30
--- /dev/null
+++ b/verify-faults.sh
@@ -0,0 +1,105 @@
+#!/usr/bin/env bash
+# Самопроверка шлюза: каждая внедрённая неисправность обязана сделать проверку
+# красной (код 1), прогон без неисправностей — зелёным (код EXPECT_BASE, по умолчанию 0).
+#
+#   ./verify-faults.sh prebuilt [НЕИСПРАВНОСТЬ…]   — verify-prebuilt.sh на bin/ (Lean не нужен)
+#   ./verify-faults.sh full     [НЕИСПРАВНОСТЬ…]   — verify.sh (нужен Lean; .lake копируется)
+#
+# Каждая неисправность внедряется в отдельную копию дерева GATE_TREE (по умолчанию —
+# это дерево), сама проверка выполняется в копии. Переменные:
+#   GATE_TREE         — дерево, чей шлюз проверяется (например, распакованная базовая версия);
+#   LAKE_CACHE        — каталог .lake для копий в режиме full (по умолчанию GATE_TREE/.lake);
+#   EXPECT_BASE       — ожидаемый код прогона без неисправностей (verify.sh с
+#                       FIGRAM_SHA256SUMS даёт 3);
+#   FAULT_LOGS        — куда складывать журналы (по умолчанию ./verify-logs/faults).
+# Код выхода 0 — все ожидания выполнены.
+set -euo pipefail
+shopt -s inherit_errexit
+export LC_ALL=C.UTF-8
+HERE=$(cd "$(dirname "$0")" && pwd)
+MODE=${1:?режим: prebuilt или full}; shift
+TREE=$(cd "${GATE_TREE:-$HERE}" && pwd)
+OUT=${FAULT_LOGS:-$HERE/verify-logs/faults}
+mkdir -p "$OUT"
+case $MODE in
+  prebuilt) SCRIPT=./verify-prebuilt.sh
+            ALL="none golden-truncated selftest-shrunk fixtures-shrunk random-docs-shrunk json-fuzz-shrunk mutants-shrunk bin-swapped";;
+  full)     SCRIPT=./verify.sh
+            ALL="none golden-truncated sums-tampered bin-swapped custom-axiom native-decide theorem-weakened go-missing race-test-not-run coverage-drop";;
+  *) echo "неизвестный режим $MODE"; exit 2;;
+esac
+FAULTS=${*:-$ALL}
+
+# sub ФАЙЛ СТАРОЕ НОВОЕ — точная замена ровно одного вхождения.
+sub() {
+  python3 - "$@" <<'PY' || exit 2
+import sys
+p, a, b = sys.argv[1:4]
+s = open(p, encoding="utf-8").read()
+if s.count(a) != 1:
+    sys.exit(f"внедрение: в {p} ожидалось ровно одно вхождение {a!r}, найдено {s.count(a)}")
+open(p, "w", encoding="utf-8").write(s.replace(a, b))
+PY
+}
+
+inject() {  # inject НЕИСПРАВНОСТЬ — в текущем каталоге (копии)
+  local P=ffi/python-example
+  case $1 in
+    none) ;;
+    golden-truncated)     # 10 из 12 фиксированных сценариев удалены (таймеры, восстановление…)
+      head -2 examples/golden.jsonl > examples/g.tmp && mv examples/g.tmp examples/golden.jsonl;;
+    sums-tampered)        # эталон хешей испорчен
+      local f=${FIGRAM_SHA256SUMS:-bin/SHA256SUMS}
+      awk 'NR==1{c=substr($0,1,1); $0=(c=="0"?"1":"0") substr($0,2)}1' "$f" > sums.tampered
+      cmp -s "$f" sums.tampered && { echo "внедрение sums-tampered не изменило файл"; exit 2; }
+      if [ -n "${FIGRAM_SHA256SUMS:-}" ]; then export FIGRAM_SHA256SUMS=$PWD/sums.tampered; else cp sums.tampered bin/SHA256SUMS; fi;;
+    bin-swapped)          # bin/figram-engine подменён, bin/SHA256SUMS не тронут
+      cp bin/figram bin/figram-engine;;
+    selftest-shrunk)      # самопроверка обвязки проверяет 1 вид порчи вместо 11
+      sub $P/harness_selftest.py '    for name, code in CORRUPT.items():' '    for name, code in list(CORRUPT.items())[:1]:';;
+    fixtures-shrunk)      # 2 граничных снимка вместо 24
+      sub $P/snapshot_fixtures.py 'engine, doc, schema_path = sys.argv[1:4]' 'FIXTURES = FIXTURES[:2]
+engine, doc, schema_path = sys.argv[1:4]';;
+    random-docs-shrunk)   # 1 случайный документ вместо 100
+      sub $P/random_docs.py '    for seed in range(count):' '    for seed in range(min(count, 1)):';;
+    json-fuzz-shrunk)     # 10 случаев фаззинга вместо 30000
+      sub $P/json_fuzz.py '    for i in range(n):' '    for i in range(min(n, 10)):';;
+    mutants-shrunk)       # по 1 мутации на документ вместо 56 и 51
+      sub $P/mutation.py '        if len(mutants) < MIN_MUTANTS:' '        mutants = mutants[:1]
+        if len(mutants) < MIN_MUTANTS:';;
+    custom-axiom)         # теорема из списка опирается на собственную аксиому
+      sub Figram/CoreProofs.lean 'theorem step_guard_local (m' 'theorem step_guard_local_orig (m'
+      sub Figram/CoreProofs.lean $'end Machine\nend Figram' $'axiom figram_cheat (m : Machine) (s : Snapshot) (ev : Event) (env₁ env₂ : HostEnv)\n    (h : ∀ n ∈ m.requiredGuards s.state ev.key, env₁ n = env₂ n) :\n    m.step s ev env₁ = m.step s ev env₂\n\ntheorem step_guard_local (m : Machine) (s : Snapshot) (ev : Event) (env₁ env₂ : HostEnv)\n    (h : ∀ n ∈ m.requiredGuards s.state ev.key, env₁ n = env₂ n) :\n    m.step s ev env₁ = m.step s ev env₂ := figram_cheat m s ev env₁ env₂ h\n\nend Machine\nend Figram';;
+    native-decide)        # доказательство вычислением в компилированном коде (аксиома ofReduceBool)
+      printf '\nexample : (20 : Nat) + 22 = 42 := by native_decide\n' >> Figram/Examples.lean;;
+    theorem-weakened)     # формулировка ослаблена: недостижимая посылка, доказательство то же
+      sub Figram/EngineProofs.lean 'theorem reply_readable (m : Machine) (hwf' 'theorem reply_readable (m : Machine) (_hfalse : False) (hwf';;
+    go-missing)           # go не установлен
+      export PATH=$(printf '%s' "$PATH" | tr ':' '\n' | while read -r d; do [ -x "$d/go" ] || printf '%s:' "$d"; done | sed 's/:$//')
+      command -v go >/dev/null && { echo "внедрение go-missing: go всё ещё в PATH"; exit 2; } || true;;
+    race-test-not-run)    # тест гонки переименован и не запускается
+      sub ffi/go-example/race_test.go 'func TestSharedRequestMap(' 'func testSharedRequestMap(';;
+    coverage-drop)        # генератор сценариев почти не выбирает события сообщений
+      sub Figram/Trace.lean '  if roll < 23 then return (.named "unknown:event", g)' '  if roll < 97 then return (.named "unknown:event", g)';;
+    *) echo "неизвестная неисправность $1"; exit 2;;
+  esac
+}
+
+ok=1
+printf '%-20s %-6s %-8s %s\n' "неисправность" "код" "ожидание" "последняя строка" | tee "$OUT/summary.txt"
+for f in $FAULTS; do
+  W=$(mktemp -d)
+  tar -C "$TREE" --exclude=./.git --exclude=./.lake --exclude=./verify-logs -cf - . | tar -xf - -C "$W"
+  if [ "$MODE" = full ]; then cp -a "${LAKE_CACHE:-$TREE/.lake}" "$W/.lake"; fi
+  set +e
+  ( cd "$W" && inject "$f" && exec timeout 1500 "$SCRIPT" ) > "$OUT/$MODE-$f.log" 2>&1
+  rc=$?
+  set -e
+  want=1; [ "$f" = none ] && want=${EXPECT_BASE:-0}
+  verdict="ok"; [ "$rc" -eq "$want" ] || { verdict="НЕТ"; ok=0; }
+  last=$(grep -v '^\s*$' "$OUT/$MODE-$f.log" | grep -v '^   (' | tail -1)
+  last=${last:0:110}
+  printf '%-20s %-6s %-8s %s %s\n' "$f" "$rc" "$want" "$verdict" "$last" | tee -a "$OUT/summary.txt"
+  rm -rf "$W"
+done
+[ $ok = 1 ] && echo "шлюз красный на каждой неисправности и зелёный без них" || { echo "НЕТ: шлюз пропускает неисправности (см. $OUT/summary.txt)"; exit 1; }
diff --git a/verify-prebuilt.sh b/verify-prebuilt.sh
index d8dea17..7ebc921 100755
--- a/verify-prebuilt.sh
+++ b/verify-prebuilt.sh
@@ -7,14 +7,25 @@
 #   ./verify-prebuilt.sh          полная проверка (~90 с на одном ядре)
 #   ./verify-prebuilt.sh --quick  сокращённая (~30 с): меньше документов и фаззинга,
 #                                 без мутаций и самопроверки обвязки — НЕ замена полной
+#
+# Код выхода: 0 — полная проверка прошла; 1 — провал; 3 — сокращённая (--quick) прошла:
+# это не полная проверка, CI обязан считать код 3 провалом.
 set -euo pipefail
+shopt -s inherit_errexit
 cd "$(dirname "$0")"
-QUICK=0; [ "${1:-}" = "--quick" ] && QUICK=1
+fail() { echo "НЕТ: $*"; exit 1; }
+case "${1:-}" in
+  "") QUICK=0;;
+  --quick) QUICK=1;;
+  *) fail "неизвестный аргумент «$1» (допустим только --quick)";;
+esac
+MIN_MUTANTS=107        # мутаций в двух документах примеров (уменьшение — провал)
+MIN_SELFTEST_OK=35     # пройденных проверок самопроверки обвязки
 F=bin/figram
 E=bin/figram-engine
 P=ffi/python-example
 (cd bin && sha256sum -c SHA256SUMS)
-python3 -c "import jsonschema" 2>/dev/null || { echo "нужен Python-пакет jsonschema: pip install jsonschema"; exit 1; }
+python3 -c "import jsonschema" 2>/dev/null || fail "нужен Python-пакет jsonschema: pip install jsonschema"
 T=$(mktemp -d)
 trap 'rm -rf "$T"' EXIT
 LOGS="$(pwd)/verify-logs"
@@ -43,33 +54,65 @@ logged() {
     echo "ОТКАЗ шага «$name» (код $rc), журнал: verify-logs/$name.log"
     grep -E "^НЕТ|РАСХОЖДЕНИЕ|Traceback|ОТКАЗ|выжила" "$LOGS/$name.log" | head -40 || true
     echo "--- хвост журнала:"; tail -25 "$LOGS/$name.log"
-    exit $rc
+    exit 1
   fi
 }
 LAST=$SECONDS
 step() { echo "   ($(( SECONDS - LAST )) с)"; LAST=$SECONDS; echo; echo "== $*"; }
-quiet_stderr() { if [ -s "$1" ]; then echo "НЕТ: исключения в stderr:"; head -5 "$1"; exit 1; fi; }
+# expect ФАЙЛ РЕГВЫР УСЛОВИЕ ОПИСАНИЕ: в файле есть строка по регулярному выражению,
+# и условие (выражение Python над числами групп g[0], g[1], …) истинно. Иначе — провал.
+expect() {
+  python3 - "$@" <<'PY' || exit 1
+import re, sys
+path, rx, cond, what = sys.argv[1:5]
+text = open(path, encoding="utf-8", errors="replace").read()
+m = re.search(rx, text, re.M)
+if not m:
+    print(f"НЕТ: {what}: в выводе нет строки вида «{rx}»"); sys.exit(1)
+g = [int(re.sub(r"[^0-9-]", "", x)) for x in m.groups()]
+if not eval(cond, {}, {"g": g}):
+    print(f"НЕТ: {what}: «{m.group(0)}» не удовлетворяет {cond}"); sys.exit(1)
+PY
+}
 
 step "Фиксированные сценарии совпадают с сохранёнными"
-$F golden "$T/golden" >/dev/null
-cmp "$T/golden/golden.jsonl" examples/golden.jsonl && echo "ok"
+$F golden "$T/golden" > "$T/golden.out"
+expect "$T/golden.out" '^сценариев: (\d+)$' "g[0] > 0 and g[0] == $(grep -c . examples/golden.jsonl)" "фиксированные сценарии"
+for f in golden.jsonl pizza.bot.json features.bot.json; do
+  cmp "$T/golden/$f" "examples/$f" || fail "examples/$f не совпадает с выводом figram golden"
+done
+echo "ok ($(cat "$T/golden.out"))"
 
 step "Соответствие движка"
-$F trace examples/pizza.bot.json 200 40 7 > "$T/pizza.jsonl"
-$F trace examples/features.bot.json 200 40 7 > "$T/features.jsonl"
+for d in pizza features; do
+  $F trace examples/$d.bot.json 200 40 7 > "$T/$d.jsonl" 2> "$T/$d.cov"
+  cat "$T/$d.cov"
+  expect "$T/$d.cov" '^покрыто вариантов стрелок: (\d+) из (\d+)$' 'g[1] > 0 and g[0] == g[1]' "покрытие $d"
+done
 python3 $P/conformance.py $E --golden examples/golden.jsonl \
-  examples/pizza.bot.json="$T/pizza.jsonl" examples/features.bot.json="$T/features.jsonl"
-logged random_docs python3 $P/random_docs.py $F $E $([ $QUICK = 1 ] && echo 20 || echo 100) 12
+  examples/pizza.bot.json="$T/pizza.jsonl" examples/features.bot.json="$T/features.jsonl" | tee "$T/conf.out"
+expect "$T/conf.out" '^запросов (\d+), расхождений (\d+)$' 'g[0] > 0 and g[1] == 0' "соответствие"
+NDOCS=$([ $QUICK = 1 ] && echo 20 || echo 100)
+logged random_docs python3 $P/random_docs.py $F $E $NDOCS 12
+expect "$LOGS/random_docs.log" '^документов (\d+), запросов (\d+), документов с расхождениями (\d+)$' \
+  "g[0] == $NDOCS and g[1] > 0 and g[2] == 0" "случайные документы"
 
 if [ $QUICK = 0 ]; then
   step "Мутационное тестирование"
   SHOW=3 logged mutation python3 $P/mutation.py $E --golden examples/golden.jsonl \
     examples/pizza.bot.json="$T/pizza.jsonl" examples/features.bot.json="$T/features.jsonl"
+  expect "$LOGS/mutation.log" '^обнаружено (\d+) из (\d+) мутаций' "g[1] >= $MIN_MUTANTS and g[0] == g[1]" "мутации"
 fi
 
 step "Снимок и текстовый JSON"
 SHOW=2 logged snapshots python3 $P/snapshot_fixtures.py $E examples/features.bot.json snapshot.schema.json
-logged json_fuzz python3 $P/json_fuzz.py $F $([ $QUICK = 1 ] && echo 5000 || echo 30000) 1
+expect "$LOGS/snapshots.log" '^снимков (\d+), ответов (\d+), расхождений схемы и движка (\d+)$' \
+  'g[0] >= 24 and g[0] == g[1] and g[2] == 0' "снимки"
+expect "$LOGS/snapshots.log" '^граница seq: ok$' 'True' "граница seq"
+NFUZZ=$([ $QUICK = 1 ] && echo 5000 || echo 30000)
+logged json_fuzz python3 $P/json_fuzz.py $F $NFUZZ 1
+expect "$LOGS/json_fuzz.log" '^случаев (\d+): принято обоими (\d+), отвергнуто обоими (\d+), расхождений (\d+)$' \
+  "g[0] == $NFUZZ and g[1] > 0 and g[2] > 0 and g[1] + g[2] == g[0] and g[3] == 0" "фаззинг JSON"
 
 step "Клиент Python"
 clean client_faults python3 $P/client_faults.py $E examples/pizza.bot.json
@@ -79,17 +122,27 @@ clean client_robustness python3 $P/client_robustness.py $E examples/pizza.bot.js
 if [ $QUICK = 0 ]; then
   step "Самопроверка обвязки"
   logged selftest python3 $P/harness_selftest.py $E examples/pizza.bot.json "$T/pizza.jsonl" "$T/features.jsonl"
+  n_ok=$(grep -c '^ok ' "$LOGS/selftest.log" || true)
+  n_bad=$(grep -c '^НЕТ' "$LOGS/selftest.log" || true)
+  [ "$n_ok" -ge "$MIN_SELFTEST_OK" ] && [ "$n_bad" -eq 0 ] \
+    || fail "самопроверка обвязки: пройдено $n_ok (нужно не меньше $MIN_SELFTEST_OK), провалено $n_bad"
 fi
 
 step "Контракт хоста и нагрузка"
 logged host python3 $P/host_sim.py $E examples/pizza.bot.json
+expect "$LOGS/host.log" '^  пользователей (\d+): дошли до конца (\d+), заказов в CRM (\d+)' \
+  'g[0] > 0 and g[0] == g[1] == g[2]' "контракт хоста"
+expect "$LOGS/host.log" '^  тест ловит нарушение: да$' 'True' "контрольный хост без контракта"
 logged load python3 $P/loadtest.py $E examples/pizza.bot.json "$T/pizza.jsonl" 64 2
+expect "$LOGS/load.log" '^потоков +(\d+), процессов (\d+): шагов (\d+) .*расхождений (\d+),' \
+  'g[0] == 64 and g[2] > 0 and g[3] == 0' "нагрузка"
 echo "   ($(( SECONDS - LAST )) с)"
 
 echo
 if [ $QUICK = 1 ]; then
   echo "СОКРАЩЁННАЯ ПРОВЕРКА ПРОЙДЕНА: пропущены мутации и самопроверка обвязки, 20 документов вместо 100,"
-  echo "5000 случаев фаззинга вместо 30000. Это не замена полной проверки."
+  echo "5000 случаев фаззинга вместо 30000. Это не замена полной проверки (код выхода 3)."
+  exit 3
 else
   echo "ПРОВЕРКА БЕЗ LEAN ПРОЙДЕНА (сборка, теоремы, C и Go не проверялись — см. ./verify.sh)"
 fi
