From 906d3d0bee0aba6dc713564ab1c7e59196524f8d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 00:07:12 +0000
Subject: [PATCH 24/40] test(core-compiler): CC-01 fixed semantics as the
 default expectation of run_all.sh

The suite encoded the baseline (Lean) reading of decision 7: a stale timer
from an older document version may fire on any message. With CC01=fixed
(new default) the oracle uses the designer reading (timer_accept=owned,
exit_cancels=snapshot) for diff-random, the red-oracle proofs and the
mutant sweep (mutants_red.py gains --oracle-opt), designer-upgrades must
be green and lint-gaps expects the non-owner timer arrow to stay dead.
CC01=baseline restores the original expectations.
Red on baseline d69bbaf (diff-random, designer-upgrades, mutants,
lint-gaps), green with the CC-01 fix.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JgWRtX2jyUidN8gxEhe5qx
---
 audit/core-compiler/lint_gaps.py   |  6 +++++-
 audit/core-compiler/mutants_red.py |  6 ++++--
 audit/core-compiler/run_all.sh     | 21 ++++++++++++++++-----
 3 files changed, 25 insertions(+), 8 deletions(-)

diff --git a/audit/core-compiler/lint_gaps.py b/audit/core-compiler/lint_gaps.py
index cba2469..acb7842 100755
--- a/audit/core-compiler/lint_gaps.py
+++ b/audit/core-compiler/lint_gaps.py
@@ -11,6 +11,7 @@ case behaves as documented in REPORT.md (accepted by check, defect observable)."
 
 import argparse
 import json
+import os
 import subprocess
 import tempfile
 
@@ -101,7 +102,10 @@ def evidence(engine, name, doc):
 
 
 EXPECT = {
-    "timer_arrow_on_non_owner": lambda ev: ev["fire_on_a"] == [] and ev["fire_with_foreign_entry"] == "z",
+    # CC-01 fixed: a foreign snapshot entry no longer fires the arrow on a non-owner (stays on a);
+    # CC01=baseline: the original observation (the arrow fires, user moves to z).
+    "timer_arrow_on_non_owner": lambda ev: ev["fire_on_a"] == [] and ev["fire_with_foreign_entry"] == (
+        "z" if os.environ.get("CC01") == "baseline" else "a"),
     "same_timer_two_messages": lambda ev: ev["old_token"] == [] and ev["new_token_at"] == "a",
     "resume_only_from_inside": lambda ev: ev["back_goes_to"] == ev["at_before"],
     "variant_after_unconditional": lambda ev: ev["targets_reached_for_all_c1"] == ["b"],
diff --git a/audit/core-compiler/mutants_red.py b/audit/core-compiler/mutants_red.py
index c6e59d2..d0a6e9e 100755
