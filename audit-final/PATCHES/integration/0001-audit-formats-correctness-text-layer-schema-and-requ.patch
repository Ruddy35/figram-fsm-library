+    outs = out.decode("utf-8").split("\n")[:-1]
+    if rc != 0 or len(outs) != len(lines_bytes):
+        raise SystemExit(f"figram json: rc={rc}, {len(outs)} answers for {len(lines_bytes)} lines; {err[:200]!r}")
+    return outs
