+        else:
+            print(f"{'    ' if ok else 'DIFF '}{rid:22s} {tag:6s} {got[:150]}" + ("" if ok else f"\n      expected {exp[:150]}"))
+    print(f"requests={len(ROWS)} replies={len(replies)} mismatches={bad} tags={tags} break={a.brk}")
+    sys.exit(1 if bad else 0)
+
+
