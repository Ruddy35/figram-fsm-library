{
  "figram": 1,
  "calls": {
    "seqa": "Sequential",
    "bg": {"text": "Background", "detached": true},
    "bgo": {"text": "Background with outcomes", "detached": true, "outcomes": ["done"]},
    "bge": {"text": "Background every", "detached": true, "outcomes": ["done"], "every": true},
    "nd": {"text": "Explicit defaults", "detached": false, "every": false}
  },
  "bot": {
    "initial": "a",
    "on": {
      "call:bgo:done": [{"to": "b"}],
      "call:bgo:failed": [{"do": ["bg"]}],
      "call:bge:done": [{"do": ["bg", "bge"]}],
      "call:bge:failed": [{"do": ["bg"]}]
    },
    "children": {
      "a": {"on": {"btn:go": [{"to": "b", "do": ["seqa", "bg", "bgo", "nd", "bge"]}], "btn:s": [{"do": ["bg", "bgo"]}]}},
      "b": {"timers": {"t": 5}, "on": {"btn:a": [{"to": "a", "do": ["bg"]}]}}
    }
  }
}
