def Figram.Format.parse : String → P J :=
fun s => do
  let __x ← parseValue 0 s.toList
  match __x with
    | (v, rest) =>
      match skipWs rest with
      | [] => pure v
      | x => throw "лишний текст после JSON"
opaque Figram.Format.parseValue : Nat → List Char → P (J × List Char)
opaque Figram.Format.render : String → J → String
opaque Figram.Format.renderCompact : J → String
opaque Figram.Format.nodeErrors : NodeId → NodeDoc → List String
opaque Figram.Format.J.keysUnique : J → Bool
def Figram.Engine.handle : Machine → String → String :=
fun m line =>
  have out :=
    match parse line with
    | Except.ok (J.obj kvs) =>
      match handleObj m kvs with
      | Except.ok j => j
      | Except.error e => J.obj [("id", (Format.get kvs "id").getD J.null), ("error", J.str e)]
    | Except.ok a => J.obj [("id", J.null), ("error", J.str "запрос должен быть объектом")]
    | Except.error e => J.obj [("id", J.null), ("error", J.str e)];
  renderCompact out
