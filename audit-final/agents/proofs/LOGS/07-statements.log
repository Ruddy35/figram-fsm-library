def Figram.Engine.handle : Machine → String → String :=
fun m line =>
  have out :=
    match parse line with
    | Except.ok (J.obj kvs) =>
      match handleObj m kvs with
      | Except.ok j => j
      | Except.error e => J.obj [("id", (Format.get kvs "id").getD J.null), ("error", J.str e)]
    | Except.ok a => J.obj [("id", J.null), ("error", J.str "запрос должен быть объектом")]
    | Except.error e => J.obj [("id", J.null), ("error", J.str e)];
  renderCompact out
