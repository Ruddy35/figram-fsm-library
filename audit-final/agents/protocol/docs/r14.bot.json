{
  "figram": 1,
  "conditions": {
    "c1": "Random condition c1",
    "c2": "Random condition c2",
    "c3": "Random condition c3"
  },
  "calls": {
    "k1": "Random action k1",
    "k2": {
      "text": "Random action k2",
      "detached": true
    },
    "k3": {
      "text": "Random action k3",
      "outcomes": ["ok", "no"]
    },
    "k4": {
      "text": "Random action k4",
      "detached": true,
      "outcomes": ["done"],
      "every": true
    }
  },
  "bot": {
    "initial": "s0",
    "on": {
      "cmd:help": [
        {
          "if": "c1",
          "to": "s0",
          "resume": true,
          "do": ["k1", "k3"]
        },
        {
          "if": "c1",
          "to": "m2",
          "do": ["k4", "k1"]
        },
        {
          "to": "s0",
          "resume": true,
          "do": ["k2"]
        }
      ],
      "call:k3:ok": [
        {
          "if": "c2",
          "to": "m0"
        }
      ],
      "call:k4:done": [
        {
          "if": "c2",
          "to": "m1",
          "do": ["k1"]
        },
        {
          "if": "c3",
          "to": "s0",
          "do": ["k3", "k2"]
        },
        {
          "to": "s0",
          "resume": true,
          "do": ["k2", "k4"]
        }
      ],
      "call:k4:failed": [
        {
          "if": "c3",
          "to": "m2",
          "back": true,
          "do": ["k2"]
        },
        {
          "if": "c1",
          "to": "m1",
          "do": ["k3"]
        },
        {
          "to": "m2"
        }
      ]
    },
    "children": {
      "s0": {
        "initial": "m2",
        "on": {
          "btn:a": [
            {
              "if": "c1",
              "to": "m1",
              "do": ["k3"]
            },
            {
              "if": "c3",
              "to": "m1",
              "do": ["k4"]
            },
            {
              "to": "s0",
              "resume": true,
              "do": ["k3", "k2"]
            }
          ],
          "btn:c": [
            {
              "if": "c2",
              "to": "m0",
              "do": ["k2", "k1"]
            }
          ]
        },
        "children": {
          "m2": {
            "on": {
              "timer:t2": [
                {
                  "to": "m2"
                }
              ]
            },
            "timers": {
              "t2": 65482
            }
          },
          "m1": {
            "on": {
              "call:k3:ok": [
                {
                  "if": "c3",
                  "to": "m1"
                }
              ],
              "call:k4:done": [
                {
                  "to": "s0",
                  "resume": true
                }
              ]
            }
          },
          "m0": {
            "on": {
              "btn:a": [
                {
                  "to": "s0",
                  "back": true,
                  "do": ["k4", "k1"]
                }
              ],
              "msg:text": [
                {
                  "if": "c2",
                  "to": "m2",
                  "do": ["k4", "k2"]
                }
              ],
              "call:k3:ok": [
                {
                  "if": "c3",
                  "to": "m2"
                },
                {
                  "if": "c1",
                  "to": "s0"
                },
                {
                  "to": "m0",
                  "do": ["k4", "k2"]
                }
              ],
              "call:k3:no": [
                {
                  "if": "c2",
                  "to": "s0",
                  "resume": true
                },
                {
                  "to": "s0",
                  "resume": true,
                  "back": true,
                  "do": ["k1"]
                }
              ],
              "call:k4:failed": [
                {
                  "to": "m1"
                }
              ]
            }
          }
        }
      }
    }
  }
}
