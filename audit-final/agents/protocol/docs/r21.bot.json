{
  "figram": 1,
  "conditions": {
    "c1": "Random condition c1",
    "c2": "Random condition c2",
    "c3": "Random condition c3"
  },
  "calls": {
    "k1": "Random action k1",
    "k2": {
      "text": "Random action k2",
      "detached": true
    },
    "k3": {
      "text": "Random action k3",
      "outcomes": ["ok", "no"]
    },
    "k4": {
      "text": "Random action k4",
      "detached": true,
      "outcomes": ["done"],
      "every": true
    }
  },
  "bot": {
    "initial": "m2",
    "on": {
      "call:k3:no": [
        {
          "if": "c2",
          "to": "s0",
          "resume": true
        },
        {
          "if": "c3",
          "to": "s0"
        },
        {
          "do": ["k2", "k1"]
        }
      ]
    },
    "children": {
      "m2": {
        "on": {
          "btn:b": [
            {
              "to": "m2"
            }
          ],
          "btn:c": [
            {
              "to": "s0",
              "resume": true,
              "do": ["k2"]
            }
          ],
          "call:k3:ok": [
            {
              "if": "c3",
              "to": "s0",
              "do": ["k3", "k2"]
            },
            {
              "if": "c2",
              "to": "s0",
              "do": ["k2"]
            }
          ]
        }
      },
      "m1": {
        "on": {
          "call:k3:no": [
            {}
          ]
        }
      },
      "s0": {
        "initial": "m0",
        "children": {
          "m0": {
            "on": {
              "btn:b": [
                {
                  "to": "m1"
                }
              ],
              "call:k4:failed": [
                {
                  "to": "m0",
                  "back": true
                }
              ]
            }
          }
        }
      }
    }
  }
}
