false | diff - /dev/null && echo ok                            continues (NOT fatal)
cmp /etc/hostname /etc/passwd >/dev/null && echo ok            continues (NOT fatal)
(cd /tmp && false && echo x)                                   aborts
false | tee /dev/null | tail -1                                aborts
(cd /tmp && false) || { echo handled; exit 1; }                aborts
[ 0 = 1 ] && Q=1                                               continues (NOT fatal)
for b in a b; do [ $b = a ] && false && echo; done             continues (NOT fatal)
x=$(false; echo y)                                             continues (NOT fatal)
