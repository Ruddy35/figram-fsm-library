{"figram": 1, "conditions": {"slot_free": "\u0412 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u043c \u0441\u043b\u043e\u0442\u0435 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e (\u0441 \u0443\u0447\u0451\u0442\u043e\u043c \u0443\u0436\u0435 \u043f\u0440\u0438\u043d\u044f\u0442\u044b\u0445, \u043d\u043e \u0435\u0449\u0451 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u043d\u044b\u0445 \u0431\u0440\u043e\u043d\u0435\u0439 \u0434\u0440\u0443\u0433\u0438\u0445 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439), \u0438 \u0443 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043d\u0435\u0442 \u0431\u0440\u043e\u043d\u0438 \u043d\u0430 \u044d\u0442\u043e\u0442 \u0441\u043b\u043e\u0442", "has_booking": "\u0423 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0435\u0441\u0442\u044c \u0430\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u0431\u0440\u043e\u043d\u044c"}, "calls": {"choose_slot": "\u0417\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0441\u043b\u043e\u0442 (\u0430\u0440\u0433\u0443\u043c\u0435\u043d\u0442 \u043a\u043d\u043e\u043f\u043a\u0438)", "reserve_slot": "\u0417\u0430\u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0441\u043b\u043e\u0442: \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u044c \u043e\u0441\u0442\u0430\u0442\u043e\u043a, \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c (\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c, \u0441\u043b\u043e\u0442)", "notify_calendar": "\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0431\u0440\u043e\u043d\u044c \u0432\u043e \u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u044c (\u0432\u043d\u0435\u0448\u043d\u0438\u0439 \u0441\u0435\u0440\u0432\u0438\u0441, \u043a\u043b\u044e\u0447 \u0438\u0434\u0435\u043c\u043f\u043e\u0442\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438)", "release_hold": "\u0421\u0431\u0440\u043e\u0441\u0438\u0442\u044c \u0432\u044b\u0431\u043e\u0440 \u0441\u043b\u043e\u0442\u0430", "cancel_booking": "\u041e\u0442\u043c\u0435\u043d\u0438\u0442\u044c \u0432\u0441\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0431\u0440\u043e\u043d\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"}, "bot": {"initial": "home", "on": {"cmd:start": [{"to": "home"}]}, "children": {"home": {"on": {"btn:book": [{"to": "booking"}], "btn:my": [{"if": "has_booking", "to": "my_booking"}, {"to": "no_booking"}]}}, "no_booking": {"on": {"btn:book": [{"to": "booking"}]}}, "my_booking": {"on": {"btn:cancel_booking": [{"to": "home", "do": ["cancel_booking"]}], "btn:book": [{"to": "booking"}]}}, "booked": {"on": {"btn:my": [{"to": "my_booking"}], "btn:book": [{"to": "booking"}]}}, "expired": {"on": {"btn:retry": [{"to": "booking"}]}}, "booking": {"initial": "pick_slot", "on": {"btn:cancel": [{"to": "home", "do": ["release_hold"]}]}, "children": {"pick_slot": {"on": {"btn:slot": [{"to": "confirm", "do": ["choose_slot"]}]}}, "confirm": {"on": {"btn:confirm": [{"if": "slot_free", "to": "nowhere", "do": ["reserve_slot", "notify_calendar"]}, {"to": "sold_out"}], "btn:back": [{"to": "pick_slot"}], "timer:hold": [{"to": "expired", "do": ["release_hold"]}], "timer:nohold": [{"to": "home"}]}, "timers": {"hold": 600000}}, "sold_out": {"on": {"btn:retry": [{"to": "pick_slot"}]}}}}}}}