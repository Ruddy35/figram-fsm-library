{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figram: снимок пользователя, версия 1",
  "description": "То, что хост хранит между событиями. Строгий: неизвестные поля запрещены. Целые поля (`seq`, жетоны) — точные целые; валидатор, хранящий числа как double (jsonschema, ajv), может принять и `1e-400` или `9007199254740990.5` — решает строгий декодер движка (FORMAT.md, «Числа»).",
  "type": "object",
  "required": ["at"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "at": { "type": "string", "minLength": 1, "description": "Текущее сообщение." },
    "resume": {
      "type": "object",
      "description": "Запомненные места: раздел → сообщение.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "timers": {
      "type": "object",
      "description": "Активные таймеры: имя → жетон запуска.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    },
    "seq": { "type": "integer", "minimum": 0, "maximum": 9007199254740991,
             "description": "Номер последнего перехода." }
  }
}
