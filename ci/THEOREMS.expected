STMT Figram.Chart.compile_correct : ∀ (c : Figram.Chart), c.compile.wf = true → ∀ (s : Figram.Snapshot) (ev : Figram.Event) (env : Figram.HostEnv), c.compile.step s ev env = c.step s ev env
STMT Figram.Chart.run_correct : ∀ (c : Figram.Chart), c.compile.wf = true → ∀ (s : Figram.Snapshot) (inp : List Figram.Input), c.compile.run s inp = c.run s inp
STMT Figram.Chart.session_correct : ∀ (c : Figram.Chart), c.compile.wf = true → ∀ (inp : List Figram.Input), c.compile.run c.compile.start.fst inp = c.run c.start.fst inp
STMT Figram.Chart.chart_run_valid : ∀ (c : Figram.Chart), c.compile.wf = true → ∀ (s : Figram.Snapshot) (x : Figram.Input) (rest : List Figram.Input), (c.run s (x :: rest)).fst.state ∈ c.leafIds
STMT Figram.Machine.step_state_valid : ∀ (m : Figram.Machine), m.wf = true → ∀ (s : Figram.Snapshot) (ev : Figram.Event) (env : Figram.HostEnv), (m.step s ev env).fst.state ∈ m.states
STMT Figram.Machine.step_guard_local : ∀ (m : Figram.Machine) (s : Figram.Snapshot) (ev : Figram.Event) (env₁ env₂ : Figram.HostEnv), (∀ (n : String), n ∈ m.requiredGuards s.state ev.key → env₁ n = env₂ n) → m.step s ev env₁ = m.step s ev env₂
STMT Figram.Chart.compile_eq_spec : ∀ (c : Figram.Chart), c.compile = c.compileSpec
STMT Figram.Chart.wfDirect_eq : ∀ (c : Figram.Chart), c.compile.wf = c.wfDirect
STMT Figram.Chart.lint_nil_wf : ∀ (c : Figram.Chart), c.lint = [] → c.compile.wf = true
STMT Figram.Machine.wfFast_eq : ∀ (m : Figram.Machine), m.wfFast = m.wf
STMT Figram.Format.decode_encode : ∀ (d : Figram.Format.Doc), Figram.Format.DocWF d → Figram.Format.decode (Figram.Format.encode d) = Except.ok d
STMT Figram.Format.encode_injective : ∀ (d₁ d₂ : Figram.Format.Doc), Figram.Format.DocWF d₁ → Figram.Format.DocWF d₂ → Figram.Format.encode d₁ = Figram.Format.encode d₂ → d₁ = d₂
STMT Figram.Format.decode_requires : ∀ (j : Figram.Format.J) (d : Figram.Format.Doc), Figram.Format.decode j = Except.ok d → ∀ (f : String), f ∈ d.requires → f ∈ Figram.Format.knownFeatures
STMT Figram.Format.toChart_strip : ∀ (d : Figram.Format.Doc), d.strip.toChart = d.toChart
STMT Figram.Format.toChart_decls : ∀ (d : Figram.Format.Doc) (conds calls vars : List (String × String)), { requires := d.requires, conditions := conds, calls := calls, variables := vars, bot := d.bot, ext := d.ext }.toChart = d.toChart
STMT Figram.Format.check_roundtrip : ∀ (d : Figram.Format.Doc), d.check = [] → Figram.Format.decode (Figram.Format.encode d) = Except.ok d
STMT Figram.Engine.decSnapshot_encSnapshot : ∀ (s : Figram.Snapshot), Figram.Engine.SnapOK s → Figram.Engine.decSnapshot (Figram.Engine.encSnapshot s) = Except.ok s
STMT Figram.Engine.step_snapOK : ∀ (m : Figram.Machine), m.wf = true → Figram.Engine.namesOK m = true → ∀ (s : Figram.Snapshot) (ev : Figram.Event) (env : Figram.HostEnv), Figram.Engine.SnapOK s → (m.step s ev env).fst.seq ≤ Figram.Format.maxInt → Figram.Engine.SnapOK (m.step s ev env).fst
STMT Figram.Engine.handle_step : ∀ (m : Figram.Machine) (kvs : Figram.Format.Obj) (j : Figram.Format.J) (s : Figram.Snapshot) (ev : Figram.Event) (gs : List (String × Bool)), Figram.Format.get kvs "op" = some (Figram.Format.J.str "step") → Figram.Format.get kvs "snapshot" = some j → Figram.Engine.decSnapshot j = Except.ok s → Figram.Engine.decEvent kvs = Except.ok ev → Figram.Engine.decGuards kvs = Except.ok gs → Figram.Engine.missing m s ev gs = [] → (m.step s ev (Figram.Engine.envOf gs)).fst.seq ≤ Figram.Format.maxInt → Figram.Engine.handleObj m kvs = Except.ok (Figram.Engine.result ((Figram.Format.get kvs "id").getD Figram.Format.J.null) (m.step s ev (Figram.Engine.envOf gs)).fst (m.step s ev (Figram.Engine.envOf gs)).snd (decide ¬s.state ∈ m.states))
STMT Figram.Engine.reply_readable : ∀ (m : Figram.Machine), m.wf = true → Figram.Engine.namesOK m = true → ∀ (s : Figram.Snapshot) (ev : Figram.Event) (env : Figram.HostEnv), Figram.Engine.SnapOK s → (m.step s ev env).fst.seq ≤ Figram.Format.maxInt → Figram.Engine.decSnapshot (Figram.Engine.encSnapshot (m.step s ev env).fst) = Except.ok (m.step s ev env).fst
STMT Figram.Engine.guards_irrelevant : ∀ (m : Figram.Machine) (s : Figram.Snapshot) (ev : Figram.Event) (gs : List (String × Bool)) (env : Figram.HostEnv), (∀ (n : String), n ∈ m.requiredGuards s.state ev.key → Figram.Engine.envOf gs n = env n) → m.step s ev (Figram.Engine.envOf gs) = m.step s ev env
STMT Figram.Engine.missing_nil_step : ∀ (m : Figram.Machine) (s : Figram.Snapshot) (ev : Figram.Event) (gs : List (String × Bool)) (env : Figram.HostEnv), Figram.Engine.missing m s ev gs = [] → (∀ (n : String) (v : Bool), Figram.Engine.givenOf gs n = some v → env n = v) → m.step s ev (Figram.Engine.envOf gs) = m.step s ev env
STMT Figram.Engine.startAt_snapOK : ∀ (m : Figram.Machine), m.wf = true → Figram.Engine.namesOK m = true → ∀ (n : Nat), n + 1 ≤ Figram.Format.maxInt → Figram.Engine.SnapOK (Figram.Engine.startAt m n).fst
