{
  "figram": 1,
  "conditions": {
    "cart_not_empty": "The cart has at least one pizza",
    "in_delivery_zone": "The address is in the delivery zone"
  },
  "calls": {
    "clear_cart": "Clear the cart",
    "save_size": "Save the chosen size",
    "add_to_cart": "Add the pizza to the cart",
    "save_address": "Save the address from the message",
    "create_order": "Create the order in the CRM"
  },
  "variables": {
    "cart": "Cart contents",
    "address": "Delivery address"
  },
  "bot": {
    "initial": "menu",
    "on": {
      "cmd:start": [
        {
          "to": "menu"
        }
      ],
      "cmd:help": [
        {
          "to": "help"
        }
      ]
    },
    "children": {
      "menu": {
        "on": {
          "btn:order": [
            {
              "to": "order"
            }
          ]
        }
      },
      "help": {
        "on": {
          "btn:back": [
            {
              "to": "order",
              "resume": true
            }
          ]
        }
      },
      "done": {},
      "reminder": {
        "on": {
          "btn:back": [
            {
              "to": "order",
              "resume": true
            }
          ]
        }
      },
      "order": {
        "initial": "catalog",
        "on": {
          "btn:cancel": [
            {
              "to": "menu",
              "do": ["clear_cart"]
            }
          ]
        },
        "children": {
          "catalog": {
            "on": {
              "btn:pizza": [
                {
                  "to": "pizza"
                }
              ],
              "btn:cart": [
                {
                  "to": "cart"
                }
              ]
            }
          },
          "pizza": {
            "initial": "pick_size",
            "children": {
              "pick_size": {
                "on": {
                  "btn:size": [
                    {
                      "to": "pick_toppings",
                      "do": ["save_size"]
                    }
                  ]
                }
              },
              "pick_toppings": {
                "on": {
                  "btn:add": [
                    {
                      "to": "cart",
                      "do": ["add_to_cart"]
                    }
                  ]
                }
              }
            }
          },
          "cart": {
            "on": {
              "btn:checkout": [
                {
                  "if": "cart_not_empty",
                  "to": "address"
                },
                {
                  "to": "catalog"
                }
              ],
              "timer:cart_reminder": [
                {
                  "to": "reminder"
                }
              ]
            },
            "timers": {
              "cart_reminder": 7200000
            }
          },
          "address": {
            "on": {
              "msg:text": [
                {
                  "if": "in_delivery_zone",
                  "to": "pay",
                  "do": ["save_address"]
                },
                {
                  "to": "pickup"
                }
              ]
            }
          },
          "pay": {
            "on": {
              "payment:success": [
                {
                  "to": "done",
                  "do": ["create_order"]
                }
              ]
            }
          },
          "pickup": {}
        }
      }
    }
  }
}
